rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isActiveUser() {
      return isSignedIn() && userDoc().data.accountStatus == 'active';
    }

    // Titik GPS wajib: lat/lng angka valid (bukan null / string / map kosong)
    function isValidGpsPoint(loc) {
      return loc is map
        && loc.keys().hasAll(['lat', 'lng'])
        && loc.lat is number
        && loc.lng is number
        && loc.lat >= -90
        && loc.lat <= 90
        && loc.lng >= -180
        && loc.lng <= 180
        // Tolak koordinat (0,0) yang sering dipakai spoof/default
        && !(loc.lat == 0 && loc.lng == 0);
    }

    function isValidAttendanceCreate() {
      let d = request.resource.data;
      return d.userId == request.auth.uid
        && d.keys().hasAll([
          'userId', 'date', 'checkIn', 'checkInLocation', 'status'
        ])
        && d.keys().hasOnly([
          'userId', 'userName', 'date',
          'checkIn', 'checkInTime', 'checkInLocation', 'checkInPhoto',
          'status',
          'checkOut', 'checkOutTime', 'checkOutLocation', 'checkOutPhoto', 'workHours',
          'locationSource', 'locationAccuracy', 'distanceFromGeofence',
          'geofenceId', 'geofenceName', 'transitionMode',
          'createdAt',
          'userRole', 'assignmentType',
          'kelurahanId', 'kelurahanNama', 'jenisTenagaAhli',
          'kantorId', 'peranKantor',
          'assignedLocation', 'distance', 'isWithinRadius', 'notes'
        ])
        && d.date is string
        && d.status is string
        && isValidGpsPoint(d.checkInLocation)
        && (
          !d.checkInLocation.keys().hasAny(['accuracy'])
          || d.checkInLocation.accuracy == null
          || (d.checkInLocation.accuracy is number
              && d.checkInLocation.accuracy >= 0
              && d.checkInLocation.accuracy <= 500)
        )
        // Tolak sumber lokasi fallback / palsu yang diketahui client lama
        && (
          !('locationSource' in d)
          || d.locationSource == null
          || !(d.locationSource in ['fallback', 'denied', 'office', 'manual'])
        )
        && (
          !('locationAccuracy' in d)
          || d.locationAccuracy == null
          || (d.locationAccuracy is number && d.locationAccuracy >= 0 && d.locationAccuracy <= 500)
        );
    }

    function isValidAttendanceUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return request.auth.uid == resource.data.userId
        && affected.hasOnly([
          'checkOut', 'checkOutTime', 'checkOutLocation', 'checkOutPhoto',
          'workHours', 'updatedAt', 'notes'
        ])
        && (
          !affected.hasAny(['checkOutLocation'])
          || d.checkOutLocation == null
          || isValidGpsPoint(d.checkOutLocation)
        );
    }

    // Self-registration may only create a pending non-admin profile.
    function isValidUserCreate(userId) {
      let d = request.resource.data;
      let allowedFields = [
        'uid', 'name', 'displayName', 'email',
        'phone', 'phoneNumber', 'nik', 'address',
        'photoURL', 'photoUrl', 'profileImage',
        'role', 'accountStatus', 'isActive',
        'provinsi', 'kota',
        'createdAt', 'registeredAt', 'createdBy', 'lastLogin',
        'location',
        'assignmentType', 'kelurahanId', 'kelurahanNama', 'jenisTenagaAhli',
        'kantorId', 'peranKantor',
        'employeeId', 'position', 'department', 'leaveBalance',
        'mustChangePassword', 'passwordResetAt', 'passwordResetBy'
      ];

      return d.keys().hasOnly(allowedFields)
        && d.keys().hasAll(['email', 'role', 'accountStatus', 'isActive'])
        && d.email is string
        && d.email == request.auth.token.email
        && d.role in ['employee', 'field_staff', 'office_staff']
        && d.accountStatus == 'pending'
        && d.isActive == false
        && (!d.keys().hasAny(['uid']) || d.uid == userId);
    }

    // A user may edit profile/contact data, but cannot promote or activate
    // their own account. Administrative account changes remain admin-only.
    function isValidSelfUserUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly([
        'name', 'displayName',
        'phone', 'phoneNumber', 'address',
        'photoURL', 'photoUrl', 'profileImage',
        'bpjsNumber', 'bpjsCardNumber',
        'emergencyContact', 'emergencyPhone',
        'maritalStatus', 'numberOfChildren', 'joinDate',
        'lastLogin', 'lastLoginAt', 'updatedAt'
      ]);
    }

    function isValidRegistrationCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(['userId', 'requestedBy', 'requestedAt', 'status'])
        && d.keys().hasAll(['userId', 'requestedBy', 'requestedAt', 'status'])
        && d.userId == request.auth.uid
        && d.requestedBy == request.auth.uid
        && d.requestedAt is timestamp
        && d.status == 'pending';
    }

    // Master data kelurahan — read semua user login, write admin
    match /kelurahan/{kelurahanId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Master data kantor — read semua user login, write admin
    match /kantor/{kantorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Konfigurasi proyek
    match /projectConfig/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users collection with enhanced security
    match /users/{userId} {
      allow read: if isSignedIn() &&
                     (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidUserCreate(userId);

      allow update: if isSignedIn() &&
                       ((request.auth.uid == userId && isValidSelfUserUpdate()) || isAdmin());

      allow delete: if isAdmin();
    }

    // Registration requests - users can create, admins manage
    match /registrationRequests/{requestId} {
      allow create: if (isSignedIn() && isValidRegistrationCreate()) || isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // Attendance — GPS wajib di server (client bisa dibypass)
    match /attendances/{attendanceId} {
      allow create: if isActiveUser() && isValidAttendanceCreate();
      allow read: if isSignedIn() &&
                     (request.auth.uid == resource.data.userId || isAdmin());
      allow update: if isActiveUser() && isValidAttendanceUpdate();
      allow delete: if isAdmin();
    }

    // Deletion logs (audit trail) - immutable, admin only
    match /deletionLogs/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // App configuration (legacy)
    match /appConfig/{configId} {
      // The public registration page must be able to detect mandatory client
      // updates. Other application configuration remains login-only.
      allow read: if configId == 'version' || isSignedIn();
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
