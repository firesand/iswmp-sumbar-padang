rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isActiveUser() &&
        (userDoc().data.role == 'admin'
          || (userDoc().data.keys().hasAny(['isAdmin'])
            && userDoc().data.isAdmin == true)
          || userDoc().data.role == 'admin_viewer'
          || userDoc().data.role == 'viewer');
    }

    function isFullAdmin() {
      return isAdmin()
        && (!userDoc().data.keys().hasAny(['adminRole'])
            || (userDoc().data.adminRole != 'viewer' && userDoc().data.adminRole != 'monitor'))
        && (!userDoc().data.keys().hasAny(['isViewer'])
            || userDoc().data.isViewer != true)
        && userDoc().data.role != 'admin_viewer'
        && userDoc().data.role != 'viewer';
    }

    function isActiveUser() {
      return isSignedIn()
        && userDoc().data.accountStatus == 'active'
        && userDoc().data.isActive == true
        && (!userDoc().data.keys().hasAny(['mustChangePassword'])
            || userDoc().data.mustChangePassword == false);
    }

    function hasDeliverablesOfficeRole() {
      let d = userDoc().data;
      return isActiveUser()
        && d.role == 'office_staff'
        && d.assignmentType == 'kantor'
        && d.kantorId == 'kantor-padang-kota'
        && d.peranKantor in [
          'TEAM_LEADER', 'TA_DATA_MANAGEMENT', 'KORKOT', 'ASMAN_DATA'
        ];
    }

    function hasDeliverablesWriteRole() {
      let d = userDoc().data;
      return isActiveUser()
        && d.role == 'office_staff'
        && d.assignmentType == 'kantor'
        && d.kantorId == 'kantor-padang-kota'
        && d.peranKantor in [
          'TEAM_LEADER', 'TA_DATA_MANAGEMENT', 'KORKOT', 'ASMAN_DATA'
        ];
    }

    function canReadDeliverables() {
      return isAdmin() || hasDeliverablesOfficeRole();
    }

    function canWriteDeliverables() {
      return isFullAdmin() || hasDeliverablesWriteRole();
    }

    function ownsCanonicalAttendance(attendanceId) {
      return isActiveUser()
        && get(
          /databases/$(database)/documents/attendances/$(attendanceId)
        ).data.userId == request.auth.uid;
    }

    function hasCanonicalFieldAssignment(d) {
      return d.role == 'field_staff'
        && d.assignmentType == 'kelurahan'
        && d.kelurahanId is string
        && d.kelurahanId.matches('^kel-[a-z0-9-]+$')
        && d.kelurahanNama is string
        && d.kelurahanNama == get(
          /databases/$(database)/documents/kelurahan/$(d.kelurahanId)
        ).data.nama
        && d.jenisTenagaAhli in ['TA_PERSAMP', 'TA_KELEMBAGAAN']
        && !d.keys().hasAny(['kantorId', 'peranKantor']);
    }

    function hasCanonicalOfficeAssignment(d) {
      return d.role == 'office_staff'
        && d.assignmentType == 'kantor'
        && d.kantorId == 'kantor-padang-kota'
        && get(
          /databases/$(database)/documents/kantor/$(d.kantorId)
        ).data.nama is string
        && d.peranKantor in [
          'TEAM_LEADER', 'TA_DATA_MANAGEMENT',
          'KORKOT', 'ASMAN_DATA', 'OPERATOR', 'OFFICE_BOY'
        ]
        && !d.keys().hasAny([
          'kelurahanId', 'kelurahanNama', 'jenisTenagaAhli'
        ]);
    }

    function hasCanonicalAssignment(d) {
      return hasCanonicalFieldAssignment(d) || hasCanonicalOfficeAssignment(d);
    }

    // Self-registration may only create a pending non-admin profile.
    function isValidUserCreate(userId) {
      let d = request.resource.data;
      let allowedFields = [
        'uid', 'name', 'displayName', 'email',
        'phone', 'phoneNumber', 'nik', 'address',
        'photoURL', 'photoUrl', 'profileImage',
        'role', 'accountStatus', 'isActive',
        'provinsi', 'kota',
        'createdAt', 'registeredAt', 'createdBy', 'lastLogin',
        'location',
        'assignmentType', 'kelurahanId', 'kelurahanNama', 'jenisTenagaAhli',
        'kantorId', 'peranKantor',
        'employeeId', 'position', 'department'
      ];
      return d.keys().hasOnly(allowedFields)
        && d.keys().hasAll([
          'name', 'email', 'role', 'accountStatus', 'isActive'
        ])
        && d.name is string
        && d.name.size() > 0
        && d.email is string
        && d.email == request.auth.token.email
        && d.role in ['field_staff', 'office_staff']
        && d.accountStatus == 'pending'
        && d.isActive == false
        && (!d.keys().hasAny(['uid']) || d.uid == userId)
        && hasCanonicalAssignment(d);
    }

    // A user may edit profile/contact data, but cannot promote or activate
    // their own account. Administrative account changes remain admin-only.
    function isValidSelfUserUpdate() {
      let after = request.resource.data;
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly([
        'bpjsNumber', 'bpjsCardNumber',
        'emergencyContact', 'address', 'updatedAt'
      ])
        && after.updatedAt == request.time
        && (!after.keys().hasAny(['bpjsNumber'])
            || after.bpjsNumber is string)
        && (!after.keys().hasAny(['bpjsCardNumber'])
            || after.bpjsCardNumber is string)
        && (!after.keys().hasAny(['emergencyContact'])
            || after.emergencyContact is string)
        && (!after.keys().hasAny(['address']) || after.address is string);
    }

    // Browser administrators may manage ordinary employee profiles, but they
    // must never be able to create another administrator, promote a user, or
    // change the geofence assignment that the attendance backend trusts.
    function isNonAdminProfile(d) {
      return d.role in ['employee', 'field_staff', 'office_staff']
        && (!d.keys().hasAny(['isAdmin']) || d.isAdmin == false);
    }

    function hasConsistentAccountState(d) {
      return d.accountStatus in [
          'pending', 'active', 'inactive', 'suspended', 'rejected',
          'resigned', 'archived'
        ]
        && ((d.accountStatus == 'active' && d.isActive == true)
            || (d.accountStatus != 'active' && d.isActive == false));
    }

    // Admin-assisted recovery may only materialize an existing Authentication
    // account from the private recovery queue as an inactive, non-admin user.
    function isValidAdminUserCreate(userId) {
      let d = request.resource.data;
      let queued = get(
        /databases/$(database)/documents/incompleteRegistrations/$(userId)
      );
      let registrationAfter = getAfter(
        /databases/$(database)/documents/registrationRequests/$(userId)
      );
      let auditAfter = getAfter(
        /databases/$(database)/documents/recoveryAuditLogs/$(userId)
      );
      let allowedFields = [
        'uid', 'name', 'email',
        'phone', 'phoneNumber', 'nik', 'address',
        'photoURL',
        'role', 'accountStatus', 'isActive',
        'provinsi', 'kota',
        'createdAt', 'originalAuthCreatedAt', 'location',
        'recoveredBy', 'recoveredAt', 'recoverySource',
        'assignmentType', 'kelurahanId', 'kelurahanNama', 'jenisTenagaAhli',
        'kantorId', 'peranKantor'
      ];
      return d.keys().hasOnly(allowedFields)
        && d.keys().hasAll([
          'uid', 'name', 'email', 'role', 'accountStatus', 'isActive',
          'createdAt', 'recoveredBy', 'recoveredAt', 'recoverySource',
          'assignmentType'
        ])
        && userId != request.auth.uid
        && d.uid == userId
        && d.name is string
        && d.name.size() > 0
        && d.email is string
        && d.email.size() > 0
        && d.createdAt == request.time
        && d.recoveredAt == request.time
        && isNonAdminProfile(d)
        && hasConsistentAccountState(d)
        && d.accountStatus == 'pending'
        && d.recoveredBy == request.auth.uid
        && d.recoverySource == 'admin-assisted'
        && queued.data.userId == userId
        && queued.data.email == d.email
        && queued.data.disabled == false
        && !existsAfter(
          /databases/$(database)/documents/incompleteRegistrations/$(userId)
        )
        && registrationAfter.data.keys().hasOnly([
          'userId', 'requestedBy', 'requestedAt', 'status', 'recoverySource'
        ])
        && registrationAfter.data.userId == userId
        && registrationAfter.data.requestedBy == request.auth.uid
        && registrationAfter.data.requestedAt == request.time
        && registrationAfter.data.status == 'pending'
        && registrationAfter.data.recoverySource == 'admin-assisted'
        && auditAfter.data.keys().hasOnly([
          'action', 'targetUserId', 'targetEmail',
          'performedBy', 'performedAt', 'source'
        ])
        && auditAfter.data.action == 'queued_for_approval'
        && auditAfter.data.targetUserId == userId
        && auditAfter.data.targetEmail == d.email
        && auditAfter.data.performedBy == request.auth.uid
        && auditAfter.data.performedAt == request.time
        && auditAfter.data.source == 'admin-assisted-recovery'
        && hasCanonicalAssignment(d);
    }

    function isValidRecoveryAuditCreate(userId) {
      let audit = request.resource.data;
      let userAfter = getAfter(
        /databases/$(database)/documents/users/$(userId)
      );
      let registrationAfter = getAfter(
        /databases/$(database)/documents/registrationRequests/$(userId)
      );

      return audit.keys().hasOnly([
          'action', 'targetUserId', 'targetEmail',
          'performedBy', 'performedAt', 'source'
        ])
        && audit.keys().hasAll([
          'action', 'targetUserId', 'targetEmail',
          'performedBy', 'performedAt', 'source'
        ])
        && audit.action == 'queued_for_approval'
        && audit.targetUserId == userId
        && audit.targetEmail == userAfter.data.email
        && audit.performedBy == request.auth.uid
        && audit.performedAt == request.time
        && audit.source == 'admin-assisted-recovery'
        && userAfter.data.uid == userId
        && userAfter.data.accountStatus == 'pending'
        && userAfter.data.isActive == false
        && userAfter.data.recoveredBy == request.auth.uid
        && userAfter.data.recoveredAt == request.time
        && userAfter.data.recoverySource == 'admin-assisted'
        && registrationAfter.data.userId == userId
        && registrationAfter.data.requestedBy == request.auth.uid
        && registrationAfter.data.requestedAt == request.time
        && registrationAfter.data.status == 'pending'
        && registrationAfter.data.recoverySource == 'admin-assisted'
        && !existsAfter(
          /databases/$(database)/documents/incompleteRegistrations/$(userId)
        );
    }

    function isValidAdminRecoveryQueueDelete(userId) {
      let userAfter = getAfter(
        /databases/$(database)/documents/users/$(userId)
      );
      return userAfter.data.uid == userId
        && userAfter.data.accountStatus == 'pending'
        && userAfter.data.isActive == false
        && userAfter.data.recoveredBy == request.auth.uid
        && userAfter.data.recoveredAt == request.time
        && userAfter.data.recoverySource == 'admin-assisted';
    }

    function isValidAdminUserUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let affected = after.diff(before).affectedKeys();
      let profileFields = [
        'name', 'employeeId', 'department', 'position',
        'phoneNumber', 'maritalStatus', 'numberOfChildren', 'joinDate',
        'address', 'emergencyContact', 'emergencyPhone'
      ];
      let touchesProfile = affected.hasAny(profileFields)
        || affected.hasAny(['updatedAt', 'updatedBy']);
      let validProfileEdit = !touchesProfile
        || (affected.hasAny(profileFields)
            && affected.hasAny(['updatedAt'])
            && after.updatedAt == request.time
            && after.updatedBy == request.auth.uid);
      let touchesAccountState = affected.hasAny([
        'accountStatus', 'isActive',
        'approvedAt', 'approvedBy',
        'rejectedAt', 'rejectedBy',
        'statusChangedAt', 'statusChangedBy'
      ]);
      let validApproval = before.accountStatus == 'pending'
        && before.isActive == false
        && after.accountStatus == 'active'
        && after.isActive == true
        && affected.hasAll([
          'accountStatus', 'isActive', 'approvedAt',
          'assignmentReviewedAt', 'assignmentReviewedBy'
        ])
        && !affected.hasAny([
          'rejectedAt', 'rejectedBy', 'statusChangedAt', 'statusChangedBy'
        ])
        && after.approvedAt == request.time
        && after.approvedBy == request.auth.uid
        && after.assignmentReviewedAt == request.time
        && after.assignmentReviewedBy == request.auth.uid
        && hasCanonicalAssignment(after);
      let validRejection = before.accountStatus == 'pending'
        && before.isActive == false
        && after.accountStatus == 'rejected'
        && after.isActive == false
        && affected.hasAll(['accountStatus', 'rejectedAt'])
        && !affected.hasAny([
          'approvedAt', 'approvedBy', 'statusChangedAt', 'statusChangedBy'
        ])
        && after.rejectedAt == request.time
        && after.rejectedBy == request.auth.uid;
      let validSuspension = before.accountStatus == 'active'
        && before.isActive == true
        && after.accountStatus == 'suspended'
        && after.isActive == false
        && affected.hasAll([
          'accountStatus', 'isActive', 'statusChangedAt'
        ])
        && !affected.hasAny([
          'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy'
        ])
        && after.statusChangedAt == request.time
        && after.statusChangedBy == request.auth.uid;
      let validReactivation = before.accountStatus == 'suspended'
        && before.isActive == false
        && after.accountStatus == 'active'
        && after.isActive == true
        && affected.hasAll([
          'accountStatus', 'isActive', 'statusChangedAt'
        ])
        && !affected.hasAny([
          'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy'
        ])
        && after.statusChangedAt == request.time
        && after.statusChangedBy == request.auth.uid;

      return isNonAdminProfile(before)
        && isNonAdminProfile(after)
        && before.accountStatus in ['pending', 'active', 'inactive', 'suspended']
        && hasConsistentAccountState(after)
        && after.keys().hasAll([
          'name', 'email', 'role', 'accountStatus', 'isActive'
        ])
        && after.name is string
        && after.email is string
        && validProfileEdit
        && (!touchesAccountState
            || validApproval
            || validRejection
            || validSuspension
            || validReactivation)
        && affected.hasOnly([
          // Approval, rejection, suspension and reactivation metadata.
          'accountStatus', 'isActive',
          'approvedAt', 'approvedBy',
          'assignmentReviewedAt', 'assignmentReviewedBy',
          'rejectedAt', 'rejectedBy',
          'statusChangedAt', 'statusChangedBy',
          // Fields exposed by the existing employee editor.
          'name', 'employeeId', 'department', 'position',
          'phoneNumber', 'maritalStatus', 'numberOfChildren', 'joinDate',
          'address', 'emergencyContact', 'emergencyPhone',
          'updatedAt', 'updatedBy'
        ]);
    }

    function isValidRegistrationCreate(requestId) {
      let d = request.resource.data;
      let profileAfter = getAfter(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
      return d.keys().hasOnly(['userId', 'requestedBy', 'requestedAt', 'status'])
        && d.keys().hasAll(['userId', 'requestedBy', 'requestedAt', 'status'])
        && d.userId == request.auth.uid
        && d.requestedBy == request.auth.uid
        && requestId == request.auth.uid
        && d.requestedAt == request.time
        && profileAfter.data.uid == request.auth.uid
        && profileAfter.data.email == request.auth.token.email
        && profileAfter.data.accountStatus == 'pending'
        && profileAfter.data.isActive == false
        && d.status == 'pending';
    }

    function isValidDeliverableSubmission(deliverableId) {
      let d = request.resource.data;
      let actor = d.updatedBy;
      return d.keys().hasOnly([
          'deliverableId', 'code', 'registrationNumber', 'status',
          'scopeChecklist', 'notes', 'driveUrl', 'videoUrl',
          'activityDate', 'activityLocation', 'attendeesCount', 'speakers',
          'discussionDate', 'discussionNotes', 'files', 'storagePaths',
          'revision',
          'submittedBy', 'submittedAt', 'lastUpdatedAt', 'updatedBy'
        ])
        && d.keys().hasAll([
          'deliverableId', 'code', 'registrationNumber', 'status',
          'scopeChecklist', 'files', 'storagePaths', 'revision',
          'lastUpdatedAt', 'updatedBy'
        ])
        && d.deliverableId == deliverableId
        && deliverableId.matches('^[a-z0-9_]{1,100}$')
        && d.code is string
        && d.code.size() > 0
        && d.code.size() <= 50
        && d.registrationNumber is string
        && d.registrationNumber.size() > 0
        && d.registrationNumber.size() <= 200
        && d.status in ['draft', 'submitted', 'review', 'approved']
        && d.scopeChecklist is map
        && d.scopeChecklist.size() <= 100
        && d.files is list
        && d.files.size() <= 100
        && d.storagePaths is list
        && d.storagePaths.size() <= 100
        && d.revision is int
        && d.revision > 0
        && (!d.keys().hasAny(['notes'])
            || (d.notes is string && d.notes.size() <= 20000))
        && (!d.keys().hasAny(['driveUrl'])
            || (d.driveUrl is string && d.driveUrl.size() <= 2048))
        && (!d.keys().hasAny(['videoUrl'])
            || (d.videoUrl is string && d.videoUrl.size() <= 2048))
        && (!d.keys().hasAny(['activityDate'])
            || (d.activityDate is string && d.activityDate.size() <= 64))
        && (!d.keys().hasAny(['activityLocation'])
            || (d.activityLocation is string
                && d.activityLocation.size() <= 500))
        && (!d.keys().hasAny(['attendeesCount'])
            || (d.attendeesCount is string
                && d.attendeesCount.size() <= 20))
        && (!d.keys().hasAny(['speakers'])
            || (d.speakers is string && d.speakers.size() <= 2000))
        && (!d.keys().hasAny(['discussionDate'])
            || (d.discussionDate is string
                && d.discussionDate.size() <= 64))
        && (!d.keys().hasAny(['discussionNotes'])
            || (d.discussionNotes is string
                && d.discussionNotes.size() <= 20000))
        && (!d.keys().hasAny(['submittedBy'])
            || d.submittedBy == null
            || (d.submittedBy is string && d.submittedBy.size() <= 500))
        && (!d.keys().hasAny(['submittedAt'])
            || d.submittedAt == null
            || d.submittedAt is timestamp
            || (d.submittedAt is string && d.submittedAt.size() <= 64))
        && (!(d.status in ['submitted', 'approved'])
            || (d.submittedBy is string
                && d.submittedBy.size() > 0
                && (d.submittedAt is timestamp
                    || (d.submittedAt is string
                        && d.submittedAt.size() > 0))))
        && d.lastUpdatedAt == request.time
        && actor is map
        && actor.keys().hasOnly(['uid', 'name', 'email', 'role'])
        && actor.keys().hasAll(['uid', 'name', 'email', 'role'])
        && actor.uid == request.auth.uid
        && actor.name is string
        && actor.name.size() > 0
        && actor.name.size() <= 500
        && actor.email is string
        && actor.email.size() <= 320
        && actor.role is string
        && actor.role.size() > 0
        && actor.role.size() <= 100;
    }

    function isValidPublicDeliverable(deliverableId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'deliverableId', 'code', 'registrationNumber', 'status',
          'scopeChecklist', 'videoUrl', 'activityDate', 'activityLocation',
          'attendeesCount', 'speakers', 'discussionDate', 'discussionNotes',
          'files', 'storagePaths', 'submittedBy', 'submittedAt', 'lastUpdatedAt'
        ])
        && d.keys().hasAll([
          'deliverableId', 'code', 'registrationNumber', 'status',
          'scopeChecklist', 'videoUrl', 'activityDate', 'activityLocation',
          'attendeesCount', 'speakers', 'discussionDate', 'discussionNotes',
          'files', 'storagePaths', 'submittedBy', 'submittedAt', 'lastUpdatedAt'
        ])
        && d.deliverableId == deliverableId
        && deliverableId.matches('^[a-z0-9_]{1,100}$')
        && d.code is string
        && d.code.size() > 0
        && d.code.size() <= 50
        && d.registrationNumber is string
        && d.registrationNumber.size() > 0
        && d.registrationNumber.size() <= 200
        && d.status in ['submitted', 'approved']
        && d.scopeChecklist is map
        && d.scopeChecklist.size() <= 100
        && d.videoUrl is string
        && d.videoUrl.size() <= 2048
        && d.activityDate is string
        && d.activityDate.size() <= 64
        && d.activityLocation is string
        && d.activityLocation.size() <= 500
        && d.attendeesCount is string
        && d.attendeesCount.size() <= 20
        && d.speakers is string
        && d.speakers.size() <= 2000
        && d.discussionDate is string
        && d.discussionDate.size() <= 64
        && d.discussionNotes is string
        && d.discussionNotes.size() <= 20000
        && d.files is list
        && d.files.size() <= 100
        && d.storagePaths is list
        && d.storagePaths.size() <= 100
        && d.submittedBy is string
        && d.submittedBy.size() > 0
        && d.submittedBy.size() <= 500
        && (d.submittedAt is timestamp
            || (d.submittedAt is string
                && d.submittedAt.size() > 0
                && d.submittedAt.size() <= 64))
        && d.lastUpdatedAt == request.time;
    }

    function isValidDeliverableUploadReservationCreate(uploadId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'uploadId', 'deliverableId', 'storagePath', 'uploadedBy',
          'status', 'createdAt', 'expiresAt'
        ])
        && d.keys().hasAll([
          'uploadId', 'deliverableId', 'storagePath', 'uploadedBy',
          'status', 'createdAt', 'expiresAt'
        ])
        && d.uploadId == uploadId
        && uploadId.matches('^[A-Za-z0-9_-]{16,80}$')
        && d.deliverableId.matches('^[a-z0-9_]{1,100}$')
        && d.storagePath.matches(
          '^deliverables/' + d.deliverableId +
          '/[A-Za-z0-9][A-Za-z0-9._-]{0,180}$'
        )
        && d.uploadedBy == request.auth.uid
        && d.status == 'pending'
        && d.createdAt == request.time
        && d.expiresAt is timestamp
        && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(1, 'h');
    }

    function isValidDeliverableUploadReservationCommit() {
      let before = resource.data;
      let after = request.resource.data;
      let submissionAfter = getAfter(
        /databases/$(database)/documents/deliverables_submissions/$(before.deliverableId)
      ).data;
      return before.uploadedBy == request.auth.uid
        && before.status == 'pending'
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'committedAt'
        ])
        && after.status == 'committed'
        && after.committedAt == request.time
        && submissionAfter.deliverableId == before.deliverableId
        && submissionAfter.lastUpdatedAt == request.time
        && submissionAfter.storagePaths is list
        && before.storagePath in submissionAfter.storagePaths;
    }

    // Attendance geofences are security policy, not ordinary master data.
    // Even an application-level admin must not be able to move a coordinate,
    // self-assert field verification, or enlarge a radius from the browser.
    // Changes go through the audited deployment/verification workflow using a
    // trusted backend identity.
    match /kelurahan/{kelurahanId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    // Same immutable-from-client policy for office geofences.
    match /kantor/{kantorId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    // Server-authoritative project configuration. Deployment scripts may
    // update it through Admin credentials; web clients are read-only.
    match /projectConfig/{configId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    // Users collection with enhanced security
    match /users/{userId} {
      allow read: if isSignedIn() &&
                     (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() &&
                       ((request.auth.uid == userId && isValidUserCreate(userId))
                         || (isFullAdmin() && isValidAdminUserCreate(userId)));

      allow update: if isSignedIn() &&
                       ((request.auth.uid == userId
                           && isActiveUser()
                           && (!isAdmin() || isFullAdmin())
                           && isValidSelfUserUpdate())
                         || (isFullAdmin() && isValidAdminUserUpdate()));

      // Employee offboarding is an audited archive operation in a callable;
      // client-side hard deletion would orphan payroll/attendance evidence.
      allow delete: if false;
    }

    // Registration requests - users can create, admins manage
    match /registrationRequests/{requestId} {
      allow create: if (isSignedIn() && isValidRegistrationCreate(requestId))
                      || isFullAdmin();
      allow read: if isAdmin();
      allow update, delete: if isFullAdmin();
    }

    // Authentication accounts whose registration profile was never saved.
    // Administrators manage the queue. The account owner may only remove their
    // own entry as part of a successful self-service registration recovery.
    match /incompleteRegistrations/{userId} {
      allow read: if isAdmin();
      // Populated only by the trusted Firebase CLI synchronization workflow.
      // A browser admin must not be able to forge its own recovery prerequisite.
      allow create, update: if false;
      allow delete: if (isSignedIn() && request.auth.uid == userId)
        || (isFullAdmin() && isValidAdminRecoveryQueueDelete(userId));
    }

    // Immutable audit trail for every admin-assisted registration recovery.
    match /recoveryAuditLogs/{logId} {
      allow create: if isFullAdmin() && isValidRecoveryAuditCreate(logId);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Attendance is server-authoritative. Callable Cloud Functions use the
    // Admin SDK and therefore bypass these client rules. Never re-enable a
    // client create/update here: coordinates, timestamps, geofence distance,
    // photos and work hours must all be validated atomically by the backend.
    match /attendances/{attendanceId} {
      allow create, update: if false;
      allow read: if (isActiveUser() && request.auth.uid == resource.data.userId)
                     || isAdmin();
      allow delete: if false;
    }

    // The active-shift pointer controls which canonical attendance a checkout
    // may close. It is private backend state and must not be discoverable or
    // mutable by either an employee or a browser administrator.
    match /attendanceOpenShifts/{userId} {
      allow read, write: if false;
    }

    // Missing-checkout proposals contain the reason and decisions contain
    // operator identities. Active administrators may review that material, but
    // every write is restricted to App Check protected callable functions.
    match /attendanceCorrectionProposals/{proposalId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /attendanceCorrectionDecisions/{decisionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The full immutable event combines the sensitive reason, both operator
    // identities and the source fingerprint. It is backend/audit tooling only.
    match /attendanceCorrectionEvents/{eventId} {
      allow read, write: if false;
    }

    // Employees can see only their approved, privacy-reduced effective view.
    // Ownership is derived from the immutable canonical attendance rather than
    // resource.data, so an owner may safely get a projection that does not yet
    // exist without opening another employee's document.
    match /attendanceCorrectionEffectiveViews/{attendanceId} {
      allow read: if ownsCanonicalAttendance(attendanceId) || isAdmin();
      allow write: if false;
    }

    // One-time upload challenges are private backend state. The Storage rules
    // may read them with firestore.get(), but no client can enumerate, forge,
    // mutate or consume a challenge document.
    match /attendanceChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /attendanceChallengeLocks/{lockId} {
      allow read, write: if false;
    }

    match /attendanceProofHashes/{digestId} {
      allow read, write: if false;
    }

    match /attendanceProofPerceptualHashes/{digestId} {
      allow read, write: if false;
    }

    match /attendancePerceptualReplayStates/{userId} {
      allow read, write: if false;
    }

    // Raw GPS sample series and their replay digests. This is forensic
    // evidence about how a fix was produced. A client that could read it would
    // learn exactly which signal signature the backend accepts, so neither an
    // employee nor an application administrator may read or write it.
    match /attendanceGpsTraces/{traceId} {
      allow read, write: if false;
    }

    match /attendanceGpsTraceDigests/{digestId} {
      allow read, write: if false;
    }

    // Retained as an explicit deny for any pre-migration documents. The v3
    // replay flow no longer reads or writes global perceptual band guards.
    match /attendanceProofPerceptualBandGuards/{bandId} {
      allow read, write: if false;
    }

    match /attendanceChallengeRateLimits/{rateId} {
      allow read, write: if false;
    }

    match /attendanceSubmitRateLimits/{rateId} {
      allow read, write: if false;
    }

    match /attendancePresenceGrants/{grantId} {
      allow read, write: if false;
    }

    // HMAC material for an independent QR/NFC/BLE presence proof is backend
    // secret state. It must never be observable or writable by a client.
    match /geofencePresenceSecrets/{secretId} {
      allow read, write: if false;
    }

    // Physical-verification proposals contain review material intended only
    // for fully active administrators. Creation, approval and mutation remain
    // server-authoritative callable operations and therefore bypass client
    // rules through the dedicated runtime identity.
    match /geofenceVerificationProposals/{proposalId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The immutable approval log may contain operator identity details and is
    // never exposed to a web client, including an application administrator.
    match /geofenceVerificationAuditLogs/{auditId} {
      allow read, write: if false;
    }

    // Private deliverable working records. Monitor/viewer accounts may read,
    // but only a full admin or an approved deliverable office role may
    // create/update. Every write records the authenticated actor and server
    // timestamp; hard deletion is intentionally unavailable to web clients.
    match /deliverables_submissions/{deliverableId} {
      allow read: if canReadDeliverables();
      allow create: if canWriteDeliverables()
        && isValidDeliverableSubmission(deliverableId)
        && request.resource.data.revision == 1;
      allow update: if canWriteDeliverables()
        && isValidDeliverableSubmission(deliverableId)
        && resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    // PII-free projection used by the intentionally shareable document route.
    // Only submitted/approved records exist here; publication/unpublication is
    // committed atomically with the private record by the client batch.
    match /deliverables_public/{deliverableId} {
      allow read: if resource.data.status in ['submitted', 'approved'];
      allow create, update: if canWriteDeliverables()
        && isValidPublicDeliverable(deliverableId);
      allow delete: if canWriteDeliverables();
    }

    // Uploads are reserved before Storage accepts bytes. Submission metadata
    // and the pending -> committed transition are written in one batch, so a
    // committed file can never use the rollback permission in Storage rules.
    match /deliverable_uploadReservations/{uploadId} {
      allow create: if canWriteDeliverables()
        && isValidDeliverableUploadReservationCreate(uploadId);
      allow read: if canWriteDeliverables()
        && (resource.data.uploadedBy == request.auth.uid || isFullAdmin());
      allow update: if canWriteDeliverables()
        && isValidDeliverableUploadReservationCommit();
      allow delete: if canWriteDeliverables()
        && resource.data.uploadedBy == request.auth.uid
        && resource.data.status == 'pending';
    }

    // Deletion logs (audit trail) - immutable, admin only
    match /deletionLogs/{logId} {
      allow create: if isFullAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // App configuration (legacy)
    match /appConfig/{configId} {
      // The public registration page must be able to detect mandatory client
      // updates. Other application configuration remains login-only.
      allow read: if configId == 'version' || isSignedIn();
      allow write: if isFullAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isFullAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
