# ISWMP SumBar-Padang — Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project details

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=iswmp-sumbar-padang.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=iswmp-sumbar-padang
VITE_FIREBASE_STORAGE_BUCKET=iswmp-sumbar-padang.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# App Configuration
VITE_APP_NAME=ISWMP SumBar-Padang
VITE_APP_VERSION=0.1.0

# Geofence defaults (actual coordinates stored in Firestore kelurahan/kantor collections)
VITE_DEFAULT_KELURAHAN_RADIUS=300
VITE_DEFAULT_KANTOR_RADIUS=200

# Attendance
VITE_CHECK_IN_DEADLINE=08:00
