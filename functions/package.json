{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --config .eslintrc.js .",
    "test": "node --test",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.0",
    "sharp": "^0.35.3"
  },
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    },
    "teeny-request@9.0.0": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0"
  },
  "private": true
}
